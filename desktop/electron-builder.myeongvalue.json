{
  "appId": "kr.co.myeongvalue.quickvaluation",
  "productName": "명밸류 IP 간이감정",
  "artifactName": "Myeongvalue-Quick-Valuation-Setup-${version}.${ext}",
  "asar": true,
  "files": [
    "main.js",
    "app/**/*"
  ],
  "directories": {
    "output": "dist/myeongvalue"
  },
  "win": {
    "icon": "app/icon.svg",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "명밸류 IP 간이감정",
    "uninstallDisplayName": "명밸류 IP 간이감정"
  }
}
