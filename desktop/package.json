{
  "name": "myeongvalue-quick-valuation-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "명밸류 IP 간이감정 내부 사용용 Windows 데스크톱 앱",
  "main": "main.js",
  "scripts": {
    "prepare:app": "node prepare.mjs",
    "start": "npm run prepare:app && electron .",
    "build:win": "npm run prepare:app && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "kr.co.myeongvalue.quickvaluation",
    "productName": "명밸류 IP 간이감정",
    "artifactName": "Myeongvalue-Quick-Valuation-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "명밸류 IP 간이감정",
      "uninstallDisplayName": "명밸류 IP 간이감정"
    }
  }
}
